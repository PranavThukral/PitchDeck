# Copy to .env.local and fill in. Never commit real values.

# MongoDB connection string. Accounts, favourites and likes need it.
MONGO_URI=

# Signs session cookies. At least 32 random characters, e.g. `openssl rand -hex 32`.
AUTH_SECRET=

# The single administrator account. Admin login is disabled while either is unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Origins other than the site's own allowed to call /api with cookies, comma separated.
ALLOWED_ORIGINS=

# Google Sheets: the opportunity and competition listings.
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_CREDENTIALS=

# Chatbot (xAI Grok).
GROK_API_KEY=
GROK_MODEL=

# Newsletter signup (MailerLite).
MAILERLITE_API_KEY=
NEXT_PUBLIC_NEWSLETTER_ENABLED=

# Public URL of the site, used in metadata, the sitemap and robots.txt.
NEXT_PUBLIC_BASE_URL=
